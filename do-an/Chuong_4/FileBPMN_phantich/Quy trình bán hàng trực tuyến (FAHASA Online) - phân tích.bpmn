    <bpmn:participant id="Participant_0ycisa9" name="Đơn vị vận chuyển" processRef="Process_0m1itu8" />
    <bpmn:participant id="Participant_0579dlt" name="Đơn vị vận chuyển" processRef="Process_0ixo0s6" />
    <bpmn:textAnnotation id="TextAnnotation_1im06ao">
      <bpmn:text>Mở website FAHASA (NVA)
Truy cập trang bán hàng (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1srfm7g">
      <bpmn:text>Nhập thông tin tài khoản (BVA)
Xác thực tài khoản (BVA)
Đăng nhập thành công (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1tpljm8">
      <bpmn:text>Nhập từ khóa sản phẩm (VA)
Xem thông tin sản phẩm (VA)
Chọn sản phẩm (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ygiok3">
      <bpmn:text>Chọn số lượng (VA)
Thêm sản phẩm vào giỏ (VA)
Kiểm tra giỏ hàng (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_09sbqwu">
      <bpmn:text>Nhập nội dung cần hỗ trợ (VA)
Gửi yêu cầu hỗ trợ (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0jijone">
      <bpmn:text>Kiểm tra số lượng sản phẩm (VA)
Kiểm tra giá trị đơn hàng (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1rzycvv">
      <bpmn:text>Nhập thông tin người nhận (BVA)
Nhập địa chỉ giao hàng (BVA)
Kiểm tra thông tin giao hàng (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0xrrb1w">
      <bpmn:text>Hiển thị thông báo lỗi (NVA)
Nhập lại thông tin giao hàng (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1akehf4">
      <bpmn:text>Xem phương thức vận chuyển khác (VA)
Chọn phương thức vận chuyển (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_07cin26">
      <bpmn:text>Xem phương thức thanh toán (BVA)
Chọn phương thức thanh toán (BVA)
Xác nhận phương thức thanh toán (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_01amn70">
      <bpmn:text>Tiếp nhận hàng (VA)
Kiểm tra sản phẩm nhận được (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0sqgty6">
      <bpmn:text>Tiếp nhận thông tin đơn hàng (BVA)
Kiểm tra thông tin đơn hàng (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r0yrac">
      <bpmn:text>Kiểm tra sản phẩm trong kho (BVA)
Xác định số lượng tồn kho (BVA)
Xác định khả năng đáp ứng đơn hàng (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0wceitd">
      <bpmn:text>Xác định sản phẩm không còn hàng (NVA)
Thông báo tình trạng hết hàng cho khách hàng (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1320hcg">
      <bpmn:text>Tổng hợp thông tin sản phẩm và khách hàng (BVA)
Tạo đơn hàng tạm thời (BVA)
Lưu thông tin đơn hàng (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12bgwxo">
      <bpmn:text>Chuẩn bị thông tin đơn hàng (BVA)
Chuyển thông tin đơn hàng đến bộ phận xử lý (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1nzk3k6">
      <bpmn:text>Chờ khách hàng xác nhận đơn (NVA)
Tiếp nhận kết quả xác nhận (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0lr5jdk">
      <bpmn:text>Tiếp nhận yêu cầu hủy đơn (NVA)
Cập nhật trạng thái đơn hàng (BVA)
Kết thúc đơn hàng (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0qgogiq">
      <bpmn:text>Tiếp nhận kết quả thanh toán (BVA)
Cập nhật trạng thái thanh toán (BVA)
Lưu trạng thái giao dịch (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11a7ikk">
      <bpmn:text>Xác định sản phẩm cần lấy (BVA)
Lấy sản phẩm theo đơn hàng (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ijdy79">
      <bpmn:text>Đối chiếu sản phẩm với đơn hàng (BVA)
Kiểm tra số lượng và tình trạng sản phẩm (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ygz2p5">
      <bpmn:text>Chuẩn bị vật liệu đóng gói (BVA)
Đóng gói sản phẩm (VA)
Hoàn thiện kiện hàng (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1wt0e3u">
      <bpmn:text>Chuẩn bị kiện hàng bàn giao (BVA)
Xác nhận thông tin bàn giao (BVA)
Bàn giao cho đơn vị vận chuyển (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ruzho7">
      <bpmn:text>Tiếp nhận yêu cầu của khách hàng (BVA)
Kiểm tra thông tin đơn hàng (BVA)
Phản hồi/giải đáp cho khách hàng (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0zqpj99">
      <bpmn:text>Tiếp nhận thông tin đơn hàng (BVA)
Tiếp nhận kiện hàng (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0tkcyvh">
      <bpmn:text>Vận chuyển đơn hàng đến địa chỉ khách hàng (VA)
Giao hàng cho khách hàng (VA)
Xác nhận giao hàng (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1st6n54">
      <bpmn:text>Cập nhật trạng thái giao hàng (BVA)
Ghi nhận giao hàng thành công (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ndvfw4">
      <bpmn:text>Ghi nhận giao hàng không thành công (NVA)
Liên hệ/xử lý lại đơn hàng (NVA)
Thực hiện giao lại nếu cần (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1yga4b8">
      <bpmn:text>Tiếp nhận yêu cầu thanh toán (BVA)
Thực hiện giao dịch thanh toán (BVA)
Kiểm tra kết quả giao dịch (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0oxi9z2">
      <bpmn:text>Xác nhận giao dịch thành công (BVA)
Gửi thông báo thanh toán thành công (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vxb17o">
      <bpmn:text>Xác định giao dịch thất bại (NVA)
Gửi thông báo thanh toán thất bại (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0y8ymm1">
      <bpmn:text>Di chuyển qua nhiều trang/chức năng (Motion)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0pkem70">
      <bpmn:text>Thực hiện thêm bước đăng nhập/xác thực (Over-processing)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_146fvsd">
      <bpmn:text>Nhập lại thông tin do nhập sai (Defects)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12jmjjo">
      <bpmn:text>Chọn lại phương thức do phương thức ban đầu không phù hợp (Defects)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0l8tgb0">
      <bpmn:text>Chuyển yêu cầu đến bộ phận hỗ trợ (Transportation)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0phkiqy">
      <bpmn:text>Đơn hàng không thể tiếp tục do hết hàng (Defects)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0nbo6qi">
      <bpmn:text>Chuyển thông tin đơn hàng đến bộ phận xử lý (Transportation)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ksltvi">
      <bpmn:text>Chờ khách hàng xác nhận đơn (Waiting)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0waid7t">
      <bpmn:text>Di chuyển để tìm và lấy sản phẩm (Motion)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0h7wu8y">
      <bpmn:text>Chuyển kiện hàng đến đơn vị vận chuyển (Transportation)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1xd0d64">
      <bpmn:text>Giao dịch thanh toán thất bại, phải thực hiện lại (Defects)</bpmn:text>
    </bpmn:textAnnotation>
