    <bpmn:textAnnotation id="TextAnnotation_0k3tgsp">
      <bpmn:text>Vận chuyển đơn hàng đến địa chỉ khách hàng (Transportation)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_18zw73k">
