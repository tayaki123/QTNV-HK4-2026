//Hình 4.2//
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_VA_CSKH_FAHASA" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CSKH" name="Bộ phận Chăm sóc khách hàng (CSKH)" processRef="Process_VA_CSKH" />
    <bpmn:textAnnotation id="TextAnnotation_TiepNhan">
      <bpmn:text>- Tiếp nhận hồ sơ khiếu nại (VA)
- Kiểm tra tính hợp lệ &amp; chứng từ (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_BoSung">
      <bpmn:text>- Soạn &amp; gửi yêu cầu bổ sung (NVA)
- Chờ khách hàng gửi lại chứng từ (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_TraCuu">
      <bpmn:text>- Nhập mã đơn &amp; tra cứu dữ liệu (BVA)
- Đối soát thông tin giao dịch (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_TuChoi">
      <bpmn:text>- Lập thông báo từ chối tiếp nhận (BVA)
- Phản hồi lý do cho khách hàng (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_PhanLoai">
      <bpmn:text>- Phân tích &amp; xếp nhóm nội dung (BVA)
- Xác định thẩm quyền giải quyết (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_XuLyTrucTiep">
      <bpmn:text>- Tư vấn &amp; giải thích chính sách (VA)
- Đưa ra phương án khắc phục (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ChuyenBP">
      <bpmn:text>- Chuyển hồ sơ sang BP chuyên môn (BVA)
- Tiếp nhận kết quả xác minh (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_PhanHoiKH">
      <bpmn:text>- Tổng hợp phương án xử lý (BVA)
- Gửi thông báo phương án cho khách (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ThuongLuong">
      <bpmn:text>- Ghi nhận lý do chưa đồng ý (VA)
- Chuyển hồ sơ yêu cầu xét lại (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ThucThi">
      <bpmn:text>- Lập lệnh hoàn tiền / đổi hàng (VA)
- Gửi dữ liệu lưu trữ hệ thống (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_TiepNhan" sourceRef="Task_CSKH_TiepNhan" targetRef="TextAnnotation_TiepNhan" />
    <bpmn:association id="Assoc_BoSung" sourceRef="Task_CSKH_YeuCauBoSung" targetRef="TextAnnotation_BoSung" />
    <bpmn:association id="Assoc_TraCuu" sourceRef="Task_CSKH_TraCuu" targetRef="TextAnnotation_TraCuu" />
    <bpmn:association id="Assoc_TuChoi" sourceRef="Task_CSKH_TuChoiDon" targetRef="TextAnnotation_TuChoi" />
    <bpmn:association id="Assoc_PhanLoai" sourceRef="Task_CSKH_PhanLoai" targetRef="TextAnnotation_PhanLoai" />
    <bpmn:association id="Assoc_XuLyTrucTiep" sourceRef="Task_CSKH_GiaiQuyetTrucTiep" targetRef="TextAnnotation_XuLyTrucTiep" />
    <bpmn:association id="Assoc_ChuyenBP" sourceRef="Task_CSKH_ChuyenBP" targetRef="TextAnnotation_ChuyenBP" />
    <bpmn:association id="Assoc_PhanHoiKH" sourceRef="Task_CSKH_GuiPhanHoi" targetRef="TextAnnotation_PhanHoiKH" />
    <bpmn:association id="Assoc_ThuongLuong" sourceRef="Task_CSKH_ThuongLuong" targetRef="TextAnnotation_ThuongLuong" />
    <bpmn:association id="Assoc_ThucThi" sourceRef="Task_CSKH_ThucThi" targetRef="TextAnnotation_ThucThi" />
  </bpmn:collaboration>
  <bpmn:process id="Process_VA_CSKH" isExecutable="false">
    <bpmn:startEvent id="Start_CSKH" name="Bắt đầu">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CSKH_TiepNhan" name="Tiếp nhận khiếu nại &#38; kiểm tra ban đầu">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G1" name="Thông tin đầy đủ &#38; hợp lệ?">
      <bpmn:incoming>Flow_To_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_HopLe</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_Thieu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CSKH_YeuCauBoSung" name="Yêu cầu bổ sung thông tin / chứng từ">
      <bpmn:incoming>Flow_G1_Thieu</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd_BoSung</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_BoSung" name="Chờ bổ sung">
      <bpmn:incoming>Flow_ToEnd_BoSung</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CSKH_TraCuu" name="Yêu cầu kiểm tra đơn hàng / giao dịch">
      <bpmn:incoming>Flow_G1_HopLe</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G2" name="Đơn hàng / giao dịch có tồn tại?">
      <bpmn:incoming>Flow_To_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_TonTai</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_KhongTonTai</bpmn:outgoing>
