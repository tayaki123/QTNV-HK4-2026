<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Waste_CSKH" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_CSKH" name="Bộ phận CSKH" processRef="Process_Waste_CSKH" />
    <bpmn:textAnnotation id="Waste_CSKH_BoSung">
      <bpmn:text>Over-processing
Soạn &amp; gửi yêu cầu bổ sung thủ công
(lãng phí nguồn lực)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_CSKH_ChoHT">
      <bpmn:text>Waiting
Chờ hệ thống đối soát dữ liệu
(độ trễ đồng bộ)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_CSKH_ChuyenBP">
      <bpmn:text>Motion / Waiting
Chuyển tiếp hồ sơ &amp; chờ chuyên môn
(thời gian chờ xác minh)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Waste_CSKH_ThuongLuong">
      <bpmn:text>Rework
Tái đàm phán và xử lý khiếu nại lại
(kéo dài chu kỳ giải quyết)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_W1" sourceRef="Task_CSKH_YeuCauBoSung" targetRef="Waste_CSKH_BoSung" />
    <bpmn:association id="Assoc_W2" sourceRef="Task_CSKH_TraCuu" targetRef="Waste_CSKH_ChoHT" />
    <bpmn:association id="Assoc_W3" sourceRef="Task_CSKH_ChuyenBP" targetRef="Waste_CSKH_ChuyenBP" />
    <bpmn:association id="Assoc_W4" sourceRef="Task_CSKH_ThuongLuong" targetRef="Waste_CSKH_ThuongLuong" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Waste_CSKH" isExecutable="false">
    <bpmn:startEvent id="Start_CSKH" name="Bắt đầu">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CSKH_TiepNhan" name="Tiếp nhận khiếu nại &#38; kiểm tra ban đầu">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G1" name="Thông tin đầy đủ &#38; hợp lệ?">
      <bpmn:incoming>Flow_To_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_HopLe</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_Thieu</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CSKH_YeuCauBoSung" name="Yêu cầu bổ sung thông tin / chứng từ">
      <bpmn:incoming>Flow_G1_Thieu</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd_BoSung</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_BoSung" name="Chờ bổ sung">
      <bpmn:incoming>Flow_ToEnd_BoSung</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CSKH_TraCuu" name="Yêu cầu kiểm tra đơn hàng / giao dịch">
      <bpmn:incoming>Flow_G1_HopLe</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G2" name="Đơn hàng / giao dịch có tồn tại?">
      <bpmn:incoming>Flow_To_G2</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_TonTai</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_KhongTonTai</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CSKH_TuChoiDon" name="Thông báo từ chối&#10;(Không tìm thấy GD)">
      <bpmn:incoming>Flow_G2_KhongTonTai</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd_TuChoi</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_TuChoiDon" name="Kết thúc (Không hợp lệ)">
      <bpmn:incoming>Flow_ToEnd_TuChoi</bpmn:incoming>
