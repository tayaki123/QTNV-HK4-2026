      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_KH_GuiKhieuNai" name="Gửi khiếu nại &#38; cung cấp chứng từ">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_Loop_BoSung</bpmn:incoming>
      <bpmn:outgoing>Flow_To_XemPA</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KH_BoSung" name="Bổ sung thông tin / bằng chứng">
      <bpmn:outgoing>Flow_Loop_BoSung</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KH_XemPhanHoi" name="Tiếp nhận &#38; đánh giá phương án giải quyết">
      <bpmn:incoming>Flow_To_XemPA</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G6_DongY" name="Khách hàng đồng ý phương án?">
      <bpmn:incoming>Flow_To_G6</bpmn:incoming>
      <bpmn:outgoing>Flow_DongY</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChuaDongY</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_KH_PhanHoiDongY" name="Xác nhận đồng ý phương án">
      <bpmn:incoming>Flow_DongY</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd_HoanTat</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_KH_HoanTat" name="Hoàn tất khiếu nại">
      <bpmn:incoming>Flow_ToEnd_HoanTat</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_KH_PhanHoiTuChoi" name="Phản hồi chưa đồng ý">
      <bpmn:incoming>Flow_ChuaDongY</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd_ChoDamPhan</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_KH_ChoDamPhan" name="Chờ đàm phán lại">
      <bpmn:incoming>Flow_ToEnd_ChoDamPhan</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_KhieuNai" targetRef="Task_KH_GuiKhieuNai" />
    <bpmn:sequenceFlow id="Flow_Loop_BoSung" sourceRef="Task_KH_BoSung" targetRef="Task_KH_GuiKhieuNai" />
    <bpmn:sequenceFlow id="Flow_To_XemPA" sourceRef="Task_KH_GuiKhieuNai" targetRef="Task_KH_XemPhanHoi" />
    <bpmn:sequenceFlow id="Flow_To_G6" sourceRef="Task_KH_XemPhanHoi" targetRef="Gateway_G6_DongY" />
    <bpmn:sequenceFlow id="Flow_DongY" name="Đồng ý" sourceRef="Gateway_G6_DongY" targetRef="Task_KH_PhanHoiDongY" />
    <bpmn:sequenceFlow id="Flow_ChuaDongY" name="Chưa đồng ý" sourceRef="Gateway_G6_DongY" targetRef="Task_KH_PhanHoiTuChoi" />
    <bpmn:sequenceFlow id="Flow_ToEnd_HoanTat" sourceRef="Task_KH_PhanHoiDongY" targetRef="End_KH_HoanTat" />
    <bpmn:sequenceFlow id="Flow_ToEnd_ChoDamPhan" sourceRef="Task_KH_PhanHoiTuChoi" targetRef="End_KH_ChoDamPhan" />
  </bpmn:process>
