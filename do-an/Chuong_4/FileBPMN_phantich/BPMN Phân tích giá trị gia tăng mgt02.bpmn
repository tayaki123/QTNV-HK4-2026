    <bpmn:startEvent id="StartEvent_1" name="Kế hoạch kinh doanh được phê duyệt">
      <bpmn:outgoing>Flow_Start_T1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="Tiếp nhận mục tiêu, chỉ tiêu từ kế hoạch đã duyệt">
      <bpmn:incoming>Flow_Start_T1</bpmn:incoming>
      <bpmn:outgoing>Flow_T1_AND_split</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="AND_split" name="Phân nhánh song song">
      <bpmn:incoming>Flow_T1_AND_split</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_split_T2a</bpmn:outgoing>
      <bpmn:outgoing>Flow_AND_split_T2b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T2a" name="Lập dự toán doanh thu, chi phí và nhu cầu nguồn lực">
      <bpmn:incoming>Flow_AND_split_T2a</bpmn:incoming>
      <bpmn:outgoing>Flow_T2a_AND_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2b" name="Lập dự toán cửa hàng và kênh trực tuyến">
      <bpmn:incoming>Flow_AND_split_T2b</bpmn:incoming>
      <bpmn:outgoing>Flow_T2b_AND_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="AND_join" name="Gộp kết quả song song">
      <bpmn:incoming>Flow_T2a_AND_join</bpmn:incoming>
      <bpmn:incoming>Flow_T2b_AND_join</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_join_GW_m1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_m1" name="Gộp vòng lặp dự toán">
      <bpmn:incoming>Flow_AND_join_GW_m1</bpmn:incoming>
      <bpmn:incoming>Flow_T3b_GW_m1</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_m1_T3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T3" name="Kiểm tra giả định, chuẩn hóa và hợp nhất dự toán toàn doanh nghiệp">
      <bpmn:incoming>Flow_GW_m1_T3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3_GW1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW1" name="Dự toán đủ căn cứ?">
      <bpmn:incoming>Flow_T3_GW1</bpmn:incoming>
      <bpmn:outgoing>Flow_GW1_T3b</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW1_GW_m2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_m2" name="Gộp vòng lặp ngân sách">
      <bpmn:incoming>Flow_GW1_GW_m2</bpmn:incoming>
      <bpmn:incoming>Flow_T4b_GW_m2</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_m2_T4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4" name="Xem xét, điều chỉnh phân bổ và phê duyệt ngân sách theo đơn vị">
      <bpmn:incoming>Flow_GW_m2_T4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4_GW2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW2" name="Ngân sách được duyệt?">
      <bpmn:incoming>Flow_T4_GW2</bpmn:incoming>
      <bpmn:outgoing>Flow_GW2_T4b</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW2_AND_split2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4b" name="Điều chỉnh ngân sách theo yêu cầu phê duyệt">
      <bpmn:incoming>Flow_GW2_T4b</bpmn:incoming>
      <bpmn:outgoing>Flow_T4b_GW_m2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="AND_split2" name="Phân nhánh song song thu thập số liệu">
      <bpmn:incoming>Flow_GW2_AND_split2</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_split2_T5a</bpmn:outgoing>
      <bpmn:outgoing>Flow_AND_split2_T5b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="AND_join2" name="Gộp số liệu">
      <bpmn:incoming>Flow_T5a_AND_join2</bpmn:incoming>
      <bpmn:incoming>Flow_T5b_AND_join2</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_join2_T6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T6" name="Đối chiếu số thực tế với ngân sách và xác định chênh lệch">
      <bpmn:incoming>Flow_AND_join2_T6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6_GW3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW3" name="Có chênh lệch trọng yếu?">
      <bpmn:incoming>Flow_T6_GW3</bpmn:incoming>
      <bpmn:outgoing>Flow_GW3_GW_m4</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW3_T7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T7" name="Giải trình nguyên nhân chênh lệch và đề xuất hành động cải thiện">
      <bpmn:incoming>Flow_GW3_T7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7_GW4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW4" name="Vượt thẩm quyền đơn vị?">
      <bpmn:incoming>Flow_T7_GW4</bpmn:incoming>
      <bpmn:outgoing>Flow_GW4_T8</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW4_GW_m4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_m4" name="Gộp trước báo cáo">
