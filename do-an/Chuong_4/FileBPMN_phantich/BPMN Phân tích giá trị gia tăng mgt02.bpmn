  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="MGT-02: Lập ngân sách, giám sát doanh thu và quản trị hiệu suất" processRef="Process_MGT02" />
    <bpmn:textAnnotation id="TextAnnotation_1wlz6na">
      <bpmn:text>Tiếp nhận chỉ tiêu KPI (BVA)
Ban hành biểu mẫu dự toán (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0d1lxn9">
      <bpmn:text>Dự toán doanh thu cửa hàng (VA)
Dự toán chi phí vận hành (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_159yob4">
      <bpmn:text>Xây dựng dự toán doanh thu (VA)
Ước tính nhu cầu nguồn lực (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_17rcwy3">
      <bpmn:text>Chuẩn hóa biểu mẫu (BVA)
Hợp nhất toàn doanh nghiệp (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1b9l084">
      <bpmn:text>Bổ sung dữ liệu thiếu (NVA)
Điều chỉnh giả định (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ucukxa">
      <bpmn:text>Xem xét phương án (NVA)
Phê duyệt phân bổ (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0pb45z9">
      <bpmn:text>Sửa đổi theo yêu cầu (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_03u0w0t">
      <bpmn:text>Đọc dữ liệu POS (BVA)
Tổng hợp theo kỳ (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04dgmi9">
      <bpmn:text>Xuất báo cáo chi phí (BVA)
Tổng hợp chi phí vận hành (BVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0h9wg6h">
      <bpmn:text>Phân tích chênh lệch (VA)
Xếp hạng ưu tiên (NVA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_04j8bn1">
      <bpmn:text>Phân tích nguyên nhân (VA)
Đề xuất hành động (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0250i67">
      <bpmn:text>Quyết định điều chuyển nguồn lực (VA)
Cập nhật dự báo (VA)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0qxpo9v">
      <bpmn:text>Soạn thảo báo cáo (BVA)
Phát hành chính thức (VA)</bpmn:text>
    </bpmn:textAnnotation>
