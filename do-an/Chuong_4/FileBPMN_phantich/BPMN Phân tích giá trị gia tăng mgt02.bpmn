      <bpmn:incoming>Flow_T8_GW_m4</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_m4_T9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T9" name="Phát hành báo cáo hiệu suất kỳ và theo dõi hoàn thành hành động">
      <bpmn:incoming>Flow_GW_m4_T9</bpmn:incoming>
      <bpmn:outgoing>Flow_T9_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Báo cáo hiệu suất kỳ được phát hành">
      <bpmn:incoming>Flow_T9_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T3b" name="Bổ sung và điều chỉnh căn cứ dự toán">
