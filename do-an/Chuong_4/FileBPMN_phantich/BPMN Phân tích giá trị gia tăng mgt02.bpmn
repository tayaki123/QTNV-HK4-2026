      <bpmn:outgoing>Flow_T5b_AND_join2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T8" name="Ban điều hành ưu tiên hành động, điều chuyển nguồn lực và cập nhật dự báo">
