        <bpmn:flowNodeRef>AND_join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5b</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CS" name="Quản lý cửa hàng &#38; kênh trực tuyến">
