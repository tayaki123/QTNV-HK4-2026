      <bpmn:incoming>Flow_T2b_AND_join</bpmn:incoming>
      <bpmn:outgoing>Flow_AND_join_GW_m1</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="GW_m1" name="Gộp vòng lặp dự toán">
