    <bpmn:participant id="Participant_1" name="MGT-02: Lập ngân sách, giám sát doanh thu và quản trị hiệu suất" processRef="Process_MGT02" />
  </bpmn:collaboration>
  <bpmn:process id="Process_MGT02" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_TC" name="Bộ phận Tài chính – Kế toán">
