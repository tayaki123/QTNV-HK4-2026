      <bpmn:outgoing>Flow_GW2_T4b</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW2_AND_split2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T4b" name="Điều chỉnh ngân sách theo yêu cầu phê duyệt">
