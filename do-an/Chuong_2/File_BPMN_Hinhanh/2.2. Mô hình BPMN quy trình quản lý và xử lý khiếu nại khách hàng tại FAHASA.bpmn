        <dc:Bounds x="2540" y="108" width="150" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_KH_1_di" bpmnElement="End_KH_1" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="2762" y="123" width="36" height="36" />
