        <dc:Bounds x="560" y="215" width="145" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KH_XemPhanHoi_di" bpmnElement="Task_KH_XemPhanHoi" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="1990" y="215" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_G6_DongY_di" bpmnElement="Gateway_G6_DongY" isMarkerVisible="true" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="2210" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2256" y="226" width="87" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KH_PhanHoiTuChoi_di" bpmnElement="Task_KH_PhanHoiTuChoi" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="2340" y="275" width="150" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_KH_2_di" bpmnElement="End_KH_2" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="2542" y="290" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2517" y="333" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KH_PhanHoiDongY_di" bpmnElement="Task_KH_PhanHoiDongY" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="2610" y="177" width="150" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_KH_1_di" bpmnElement="End_KH_1" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="2822" y="192" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2796" y="235" width="89" height="14" />
