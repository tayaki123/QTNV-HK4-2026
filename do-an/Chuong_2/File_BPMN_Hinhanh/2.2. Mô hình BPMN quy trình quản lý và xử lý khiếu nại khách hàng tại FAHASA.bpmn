<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Complaints_NoOverlap" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collaboration_Complaints">
    <bpmn:participant id="Participant_Customer" name="Khách hàng" processRef="Process_Customer" />
    <bpmn:participant id="Participant_FAHASA" name="FAHASA" processRef="Process_FAHASA" />
    <bpmn:messageFlow id="Flow_Msg_1" name="Gửi thông tin / bằng chứng" sourceRef="Task_Cus_SendProof" targetRef="Task_CSKH_Receive" />
    <bpmn:messageFlow id="Flow_Msg_2" name="Yêu cầu bổ sung thông tin" sourceRef="Task_CSKH_Forward" targetRef="Task_Cus_ProvideMore" />
    <bpmn:messageFlow id="Flow_Msg_3" name="Phản hồi kết quả xử lý" sourceRef="Task_Action_Exchange" targetRef="Task_Cus_ReceiveRes" />
  </bpmn:collaboration>

  <bpmn:process id="Process_Customer" isExecutable="false">
    <bpmn:startEvent id="Start_Cus" name="Bắt đầu">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Cus_Check" name="Kiểm tra sản phẩm">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_Need" name="Phát sinh nhu cầu đổi/trả hoặc hoàn tiền">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_SendReq" name="Gửi yêu cầu đổi trả">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_SendInfo" name="Cung cấp thông tin đơn hàng">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_C5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_SendProof" name="Cung cấp hình ảnh/video bằng chứng">
      <bpmn:incoming>Flow_C5</bpmn:incoming>
      <bpmn:outgoing>Flow_C6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_ProvideMore" name="Bổ sung thông tin">
      <bpmn:incoming>Flow_C6</bpmn:incoming>
      <bpmn:outgoing>Flow_C7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_ReceiveRes" name="Nhận thông báo kết quả xử lý">
      <bpmn:incoming>Flow_C7</bpmn:incoming>
      <bpmn:outgoing>Flow_C8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Cus" name="Kết thúc">
      <bpmn:incoming>Flow_C8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="Start_Cus" targetRef="Task_Cus_Check" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_Cus_Check" targetRef="Task_Cus_Need" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_Cus_Need" targetRef="Task_Cus_SendReq" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_Cus_SendReq" targetRef="Task_Cus_SendInfo" />
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Task_Cus_SendInfo" targetRef="Task_Cus_SendProof" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_Cus_SendProof" targetRef="Task_Cus_ProvideMore" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Task_Cus_ProvideMore" targetRef="Task_Cus_ReceiveRes" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="Task_Cus_ReceiveRes" targetRef="End_Cus" />
  </bpmn:process>

  <bpmn:process id="Process_FAHASA" isExecutable="false">
    <bpmn:laneSet id="LaneSet_FAHASA">
      <bpmn:lane id="Lane_CSKH" name="Bộ phận CSKH">
        <bpmn:flowNodeRef>Task_CSKH_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_Forward</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Officer" name="Nhân viên xử lý đổi trả">
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Prepare_Sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm_Other</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Action_Exchange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FAHASA_Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Bộ phận kho">
        <bpmn:flowNodeRef>Task_WH_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WH_Check</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <!-- CSKH Lane -->
    <bpmn:task id="Task_CSKH_Receive" name="Tiếp nhận yêu cầu đổi/trả">
      <bpmn:outgoing>Flow_F_CSKH1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CSKH_Forward" name="Gửi thông tin yêu cầu đến nhân viên xử lý">
      <bpmn:incoming>Flow_F_CSKH1</bpmn:incoming>
      <bpmn:outgoing>Flow_F_CSKH2</bpmn:outgoing>
    </bpmn:task>

    <!-- Officer Lane -->
    <bpmn:exclusiveGateway id="Gateway_1" name="Yêu cầu còn trong thời hạn?">
      <bpmn:incoming>Flow_F_CSKH2</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject_1" name="Thông báo từ chối">
      <bpmn:incoming>Flow_G1_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Rej1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_2" name="Đơn hàng có hợp lệ?">
      <bpmn:incoming>Flow_G1_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject_2" name="Thông báo từ chối">
      <bpmn:incoming>Flow_G2_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Rej2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_3" name="Sản phẩm đủ điều kiện đổi/trả?">
      <bpmn:incoming>Flow_G2_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject_3" name="Thông báo từ chối">
      <bpmn:incoming>Flow_G3_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Rej3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_4" name="Cần thu hồi sản phẩm?">
      <bpmn:incoming>Flow_G3_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_5" name="Sản phẩm trả về đạt yêu cầu?">
      <bpmn:incoming>Flow_WH_Checked</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject_4" name="Thông báo từ chối">
      <bpmn:incoming>Flow_G5_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Rej4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_6" name="Sản phẩm còn hàng để đổi?">
      <bpmn:incoming>Flow_G5_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_G6_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G6_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject_5" name="Thông báo từ chối">
      <bpmn:incoming>Flow_G6_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Rej5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_7" name="Phương án xử lý của KH?">
      <bpmn:incoming>Flow_G6_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_G4_No</bpmn:incoming>
      <bpmn:outgoing>Flow_G7_Same</bpmn:outgoing>
      <bpmn:outgoing>Flow_G7_Diff</bpmn:outgoing>
      <bpmn:outgoing>Flow_G7_Refund</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Prepare_Sub" name="Chuẩn bị sản phẩm thay thế">
      <bpmn:incoming>Flow_G7_Same</bpmn:incoming>
      <bpmn:incoming>Flow_Diff_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Exchange</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirm_Other" name="Xác nhận sản phẩm thay thế với KH">
      <bpmn:incoming>Flow_G7_Diff</bpmn:incoming>
      <bpmn:outgoing>Flow_Diff_Done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Action_Exchange" name="Hoàn tất xử lý đổi/trả">
      <bpmn:incoming>Flow_To_Exchange</bpmn:incoming>
      <bpmn:incoming>Flow_G7_Refund</bpmn:incoming>
    </bpmn:task>

    <bpmn:endEvent id="End_FAHASA_Cancel" name="Kết thúc">
      <bpmn:incoming>Flow_Rej1</bpmn:incoming>
      <bpmn:incoming>Flow_Rej2</bpmn:incoming>
      <bpmn:incoming>Flow_Rej3</bpmn:incoming>
      <bpmn:incoming>Flow_Rej4</bpmn:incoming>
      <bpmn:incoming>Flow_Rej5</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Warehouse Lane -->
    <bpmn:task id="Task_WH_Receive" name="Tiếp nhận sản phẩm trả về">
      <bpmn:incoming>Flow_G4_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_WH_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WH_Check" name="Kiểm tra sản phẩm">
      <bpmn:incoming>Flow_WH_1</bpmn:incoming>
      <bpmn:outgoing>Flow_WH_Checked</bpmn:outgoing>
    </bpmn:task>

    <!-- Sequence flows inside FAHASA -->
    <bpmn:sequenceFlow id="Flow_F_CSKH1" sourceRef="Task_CSKH_Receive" targetRef="Task_CSKH_Forward" />
    <bpmn:sequenceFlow id="Flow_F_CSKH2" sourceRef="Task_CSKH_Forward" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_G1_Yes" name="Có" sourceRef="Gateway_1" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_G1_No" name="Không" sourceRef="Gateway_1" targetRef="Task_Reject_1" />
    <bpmn:sequenceFlow id="Flow_Rej1" sourceRef="Task_Reject_1" targetRef="End_FAHASA_Cancel" />

    <bpmn:sequenceFlow id="Flow_G2_Yes" name="Có" sourceRef="Gateway_2" targetRef="Gateway_3" />
    <bpmn:sequenceFlow id="Flow_G2_No" name="Không" sourceRef="Gateway_2" targetRef="Task_Reject_2" />
    <bpmn:sequenceFlow id="Flow_Rej2" sourceRef="Task_Reject_2" targetRef="End_FAHASA_Cancel" />

    <bpmn:sequenceFlow id="Flow_G3_Yes" name="Có" sourceRef="Gateway_3" targetRef="Gateway_4" />
    <bpmn:sequenceFlow id="Flow_G3_No" name="Không" sourceRef="Gateway_3" targetRef="Task_Reject_3" />
    <bpmn:sequenceFlow id="Flow_Rej3" sourceRef="Task_Reject_3" targetRef="End_FAHASA_Cancel" />

    <bpmn:sequenceFlow id="Flow_G4_Yes" name="Có" sourceRef="Gateway_4" targetRef="Task_WH_Receive" />
    <bpmn:sequenceFlow id="Flow_G4_No" name="Không" sourceRef="Gateway_4" targetRef="Gateway_7" />

    <bpmn:sequenceFlow id="Flow_WH_1" sourceRef="Task_WH_Receive" targetRef="Task_WH_Check" />
    <bpmn:sequenceFlow id="Flow_WH_Checked" sourceRef="Task_WH_Check" targetRef="Gateway_5" />

    <bpmn:sequenceFlow id="Flow_G5_Yes" name="Có" sourceRef="Gateway_5" targetRef="Gateway_6" />
    <bpmn:sequenceFlow id="Flow_G5_No" name="Không" sourceRef="Gateway_5" targetRef="Task_Reject_4" />
    <bpmn:sequenceFlow id="Flow_Rej4" sourceRef="Task_Reject_4" targetRef="End_FAHASA_Cancel" />

    <bpmn:sequenceFlow id="Flow_G6_Yes" name="Có" sourceRef="Gateway_6" targetRef="Gateway_7" />
    <bpmn:sequenceFlow id="Flow_G6_No" name="Không" sourceRef="Gateway_6" targetRef="Task_Reject_5" />
    <bpmn:sequenceFlow id="Flow_Rej5" sourceRef="Task_Reject_5" targetRef="End_FAHASA_Cancel" />

    <bpmn:sequenceFlow id="Flow_G7_Same" name="Đổi cùng loại" sourceRef="Gateway_7" targetRef="Task_Prepare_Sub" />
    <bpmn:sequenceFlow id="Flow_G7_Diff" name="Đổi khác loại" sourceRef="Gateway_7" targetRef="Task_Confirm_Other" />
    <bpmn:sequenceFlow id="Flow_Diff_Done" sourceRef="Task_Confirm_Other" targetRef="Task_Prepare_Sub" />
    <bpmn:sequenceFlow id="Flow_G7_Refund" name="Hoàn tiền" sourceRef="Gateway_7" targetRef="Task_Action_Exchange" />
    <bpmn:sequenceFlow id="Flow_To_Exchange" sourceRef="Task_Prepare_Sub" targetRef="Task_Action_Exchange" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Complaints">
      
      <!-- Pool Customer -->
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2480" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Cus_di" bpmnElement="Start_Cus" bioc:stroke="#198754" bioc:fill="#d1e7dd" color:background-color="#d1e7dd" color:border-color="#198754">
        <dc:Bounds x="210" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="210" y="185" width="38" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_Check_di" bpmnElement="Task_Cus_Check" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="280" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_Need_di" bpmnElement="Task_Cus_Need" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="420" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_SendReq_di" bpmnElement="Task_Cus_SendReq" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="570" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_SendInfo_di" bpmnElement="Task_Cus_SendInfo" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="710" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_SendProof_di" bpmnElement="Task_Cus_SendProof" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="860" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_ProvideMore_di" bpmnElement="Task_Cus_ProvideMore" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="1030" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_ReceiveRes_di" bpmnElement="Task_Cus_ReceiveRes" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="2250" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Cus_di" bpmnElement="End_Cus" bioc:stroke="#198754" bioc:fill="#d1e7dd" color:background-color="#d1e7dd" color:border-color="#198754">
        <dc:Bounds x="2410" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2408" y="185" width="41" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_C1_di" bpmnElement="Flow_C1">
        <di:waypoint x="246" y="160" />
        <di:waypoint x="280" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C2_di" bpmnElement="Flow_C2">
        <di:waypoint x="380" y="160" />
        <di:waypoint x="420" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C3_di" bpmnElement="Flow_C3">
        <di:waypoint x="530" y="160" />
        <di:waypoint x="570" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C4_di" bpmnElement="Flow_C4">
        <di:waypoint x="670" y="160" />
        <di:waypoint x="710" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C5_di" bpmnElement="Flow_C5">
        <di:waypoint x="820" y="160" />
        <di:waypoint x="860" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C6_di" bpmnElement="Flow_C6">
        <di:waypoint x="970" y="160" />
        <di:waypoint x="1030" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C7_di" bpmnElement="Flow_C7">
        <di:waypoint x="1130" y="160" />
        <di:waypoint x="2250" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C8_di" bpmnElement="Flow_C8">
        <di:waypoint x="2360" y="160" />
        <di:waypoint x="2410" y="160" />
      </bpmndi:BPMNEdge>

      <!-- Pool FAHASA -->
      <bpmndi:BPMNShape id="Participant_FAHASA_di" bpmnElement="Participant_FAHASA" isHorizontal="true">
        <dc:Bounds x="160" y="300" width="2480" height="620" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_CSKH_di" bpmnElement="Lane_CSKH" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="2450" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Officer_di" bpmnElement="Lane_Officer" isHorizontal="true">
        <dc:Bounds x="190" y="450" width="2450" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Warehouse_di" bpmnElement="Lane_Warehouse" isHorizontal="true">
        <dc:Bounds x="190" y="770" width="2450" height="150" />
      </bpmndi:BPMNShape>

      <!-- CSKH Lane -->
      <bpmndi:BPMNShape id="Task_CSKH_Receive_di" bpmnElement="Task_CSKH_Receive" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="300" y="335" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CSKH_Forward_di" bpmnElement="Task_CSKH_Forward" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="480" y="335" width="110" height="80" />
