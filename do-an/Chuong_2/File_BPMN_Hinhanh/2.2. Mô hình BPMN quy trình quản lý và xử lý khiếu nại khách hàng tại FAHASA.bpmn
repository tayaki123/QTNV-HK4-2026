        <dc:Bounds x="2270" y="165" width="150" height="65" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_KH_2_di" bpmnElement="End_KH_2" bioc:stroke="#8a1f1d" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#8a1f1d">
