<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_FAHASA_Fix_Labels" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_KhieuNai">
    <bpmn:participant id="Participant_KhachHang" name="Khách hàng" processRef="Process_KhachHang" />
    <bpmn:participant id="Participant_FAHASA" name="Công ty FAHASA" processRef="Process_FAHASA" />
    <bpmn:messageFlow id="MsgFlow_GuiKhieuNai" name="Gửi hồ sơ khiếu nại" sourceRef="Task_KH_GuiKhieuNai" targetRef="Task_CSKH_TiepNhan" />
    <bpmn:messageFlow id="MsgFlow_YeuCauBoSung" name="Yêu cầu bổ sung" sourceRef="Task_CSKH_YeuCauBoSung" targetRef="Task_KH_BoSung" />
    <bpmn:messageFlow id="MsgFlow_GuiBoSung" sourceRef="Task_KH_BoSung" targetRef="Task_CSKH_TiepNhan" />
    <bpmn:messageFlow id="MsgFlow_PhanHoiKH" name="Gửi phương án giải quyết" sourceRef="Task_CSKH_GuiPhanHoi" targetRef="Task_KH_XemPhanHoi" />
    <bpmn:messageFlow id="MsgFlow_DongY" name="Đồng ý phương án" sourceRef="Task_KH_PhanHoiDongY" targetRef="Task_CSKH_ThucThi" />
    <bpmn:messageFlow id="MsgFlow_TuChoi" name="Từ chối / Yêu cầu đàm phán" sourceRef="Task_KH_PhanHoiTuChoi" targetRef="Task_CSKH_ThuongLuong" />
  </bpmn:collaboration>
  <bpmn:process id="Process_KhachHang" isExecutable="false">
    <bpmn:startEvent id="Start_KhieuNai" name="Phát sinh khiếu nại">
      <bpmn:outgoing>Flow_KH_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_KH_GuiKhieuNai" name="Gửi khiếu nại &#38; cung cấp chứng từ">
      <bpmn:incoming>Flow_KH_1</bpmn:incoming>
      <bpmn:incoming>Flow_KH_LoopFromBoSung</bpmn:incoming>
      <bpmn:outgoing>Flow_KH_ChoPhanHoi</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KH_BoSung" name="Bổ sung thông tin / bằng chứng">
      <bpmn:outgoing>Flow_KH_LoopFromBoSung</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KH_XemPhanHoi" name="Tiếp nhận &#38; đánh giá phương án giải quyết">
      <bpmn:incoming>Flow_KH_ChoPhanHoi</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_KH_PhanHoiTuChoi" name="Phản hồi chưa đồng ý">
      <bpmn:incoming>Flow_KH_To_TuChoi</bpmn:incoming>
      <bpmn:outgoing>Flow_KH_End2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_KH_2" name="Chờ đàm phán lại">
      <bpmn:incoming>Flow_KH_End2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_KH_1" sourceRef="Start_KhieuNai" targetRef="Task_KH_GuiKhieuNai" />
    <bpmn:sequenceFlow id="Flow_KH_LoopFromBoSung" sourceRef="Task_KH_BoSung" targetRef="Task_KH_GuiKhieuNai" />
    <bpmn:sequenceFlow id="Flow_KH_ChoPhanHoi" sourceRef="Task_KH_GuiKhieuNai" targetRef="Task_KH_XemPhanHoi" />
    <bpmn:sequenceFlow id="Flow_To_G6" sourceRef="Task_KH_XemPhanHoi" targetRef="Gateway_G6_DongY" />
    <bpmn:sequenceFlow id="Flow_KH_To_DongY" name="Đồng ý" sourceRef="Gateway_G6_DongY" targetRef="Task_KH_PhanHoiDongY" />
    <bpmn:sequenceFlow id="Flow_KH_To_TuChoi" name="Chưa đồng ý" sourceRef="Gateway_G6_DongY" targetRef="Task_KH_PhanHoiTuChoi" />
    <bpmn:sequenceFlow id="Flow_KH_End1" sourceRef="Task_KH_PhanHoiDongY" targetRef="End_KH_1" />
    <bpmn:sequenceFlow id="Flow_KH_End2" sourceRef="Task_KH_PhanHoiTuChoi" targetRef="End_KH_2" />
    <bpmn:exclusiveGateway id="Gateway_G6_DongY" name="Khách hàng đồng ý phương án?">
      <bpmn:incoming>Flow_To_G6</bpmn:incoming>
      <bpmn:outgoing>Flow_KH_To_DongY</bpmn:outgoing>
      <bpmn:outgoing>Flow_KH_To_TuChoi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_KH_PhanHoiDongY" name="Xác nhận đồng ý phương án">
      <bpmn:incoming>Flow_KH_To_DongY</bpmn:incoming>
      <bpmn:outgoing>Flow_KH_End1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_KH_1" name="Hoàn tất khiếu nại">
      <bpmn:incoming>Flow_KH_End1</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_FAHASA" isExecutable="false">
    <bpmn:laneSet id="LaneSet_FAHASA">
      <bpmn:lane id="Lane_CSKH" name="Bộ phận CSKH">
        <bpmn:flowNodeRef>Task_CSKH_TiepNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G1_HopLe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_YeuCauBoSung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_TraCuu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G2_TonTai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_TuChoiDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_TuChoiDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_PhanLoai</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G3_PhamVi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_GiaiQuyetTrucTiep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_GuiPhanHoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_ThuongLuong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_ThucThi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HoanTat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_HoiTu_PhuongAn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ChuyenMon" name="Bộ phận Chuyên môn&#10;(Bán hàng / Đơn hàng / BP liên quan)">
        <bpmn:flowNodeRef>Task_BP_XacMinh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP_DeXuat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G5_ChinhSach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BP_TuChoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_G4_HopLeThucTe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HeThong" name="Hệ thống Quản lý Khiếu nại">
        <bpmn:flowNodeRef>Task_HT_TraCuuDon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HT_LuuKetQua</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Task_CSKH_TiepNhan" name="Tiếp nhận khiếu nại &#38; kiểm tra ban đầu">
      <bpmn:outgoing>Flow_To_G1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G1_HopLe" name="Thông tin đầy đủ &#38; hợp lệ?">
      <bpmn:incoming>Flow_To_G1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_HopLe</bpmn:outgoing>
      <bpmn:outgoing>Flow_YeuCauBoSung_CSKH</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CSKH_YeuCauBoSung" name="Yêu cầu bổ sung thông tin / chứng từ">
      <bpmn:incoming>Flow_YeuCauBoSung_CSKH</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_CSKH_TraCuu" name="Yêu cầu kiểm tra đơn hàng / giao dịch">
      <bpmn:incoming>Flow_G1_HopLe</bpmn:incoming>
      <bpmn:outgoing>Flow_To_HT</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G2_TonTai" name="Đơn hàng / giao dịch có tồn tại?">
      <bpmn:incoming>Flow_From_HT</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_TonTai</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_KhongTonTai</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CSKH_TuChoiDon" name="Thông báo từ chối&#10;(Không tìm thấy GD)">
      <bpmn:incoming>Flow_G2_KhongTonTai</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndTuChoi</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_TuChoiDon" name="Kết thúc&#10;(Không hợp lệ)">
      <bpmn:incoming>Flow_ToEndTuChoi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_CSKH_PhanLoai" name="Phân loại nội dung khiếu nại">
      <bpmn:incoming>Flow_G2_TonTai</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G3_PhamVi" name="Thuộc phạm vi CSKH xử lý trực tiếp?">
      <bpmn:incoming>Flow_To_G3</bpmn:incoming>
      <bpmn:outgoing>Flow_CSKH_XuLy</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChuyenChuyenMon</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CSKH_GiaiQuyetTrucTiep" name="Giải thích chính sách &#38; xử lý trực tiếp">
      <bpmn:incoming>Flow_CSKH_XuLy</bpmn:incoming>
      <bpmn:outgoing>Flow_CSKH_DonePA</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CSKH_GuiPhanHoi" name="Phản hồi phương án xử lý cho khách hàng">
      <bpmn:incoming>Flow_To_PhanHoiKH</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_CSKH_ThuongLuong" name="Đàm phán lại / Chuyển cấp thẩm quyền">
      <bpmn:outgoing>Flow_Loop_DieuChinh</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CSKH_ThucThi" name="Thực thi giải pháp&#10;(Đổi trả / Hoàn tiền)">
      <bpmn:outgoing>Flow_To_HT_Luu</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_HoanTat" name="Hoàn tất khiếu nại">
      <bpmn:incoming>Flow_ToEndHoanTat</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_BP_XacMinh" name="Xác minh nguyên nhân &#38; tính hợp lệ">
      <bpmn:incoming>Flow_ChuyenChuyenMon</bpmn:incoming>
      <bpmn:incoming>Flow_Loop_DieuChinh</bpmn:incoming>
      <bpmn:incoming>Flow_ChinhSach_Sua</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_BP_DeXuat" name="Đề xuất phương án giải quyết">
      <bpmn:incoming>Flow_G4_HopLe</bpmn:incoming>
      <bpmn:outgoing>Flow_To_G5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G5_ChinhSach" name="Phương án đúng chính sách FAHASA?">
      <bpmn:incoming>Flow_To_G5</bpmn:incoming>
      <bpmn:outgoing>Flow_BP_DonePA</bpmn:outgoing>
      <bpmn:outgoing>Flow_ChinhSach_Sua</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_HT_TraCuuDon" name="Truy xuất &#38; đối soát dữ liệu giao dịch">
      <bpmn:incoming>Flow_To_HT</bpmn:incoming>
      <bpmn:outgoing>Flow_From_HT</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_HT_LuuKetQua" name="Lưu lịch sử, kết quả &#38; đóng khiếu nại">
      <bpmn:incoming>Flow_To_HT_Luu</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndHoanTat</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_To_G1" sourceRef="Task_CSKH_TiepNhan" targetRef="Gateway_G1_HopLe" />
    <bpmn:sequenceFlow id="Flow_G1_HopLe" name="Đầy đủ / Hợp lệ" sourceRef="Gateway_G1_HopLe" targetRef="Task_CSKH_TraCuu" />
    <bpmn:sequenceFlow id="Flow_YeuCauBoSung_CSKH" name="Thiếu thông tin" sourceRef="Gateway_G1_HopLe" targetRef="Task_CSKH_YeuCauBoSung" />
    <bpmn:sequenceFlow id="Flow_To_HT" sourceRef="Task_CSKH_TraCuu" targetRef="Task_HT_TraCuuDon" />
    <bpmn:sequenceFlow id="Flow_From_HT" sourceRef="Task_HT_TraCuuDon" targetRef="Gateway_G2_TonTai" />
    <bpmn:sequenceFlow id="Flow_G2_TonTai" name="Tồn tại" sourceRef="Gateway_G2_TonTai" targetRef="Task_CSKH_PhanLoai" />
    <bpmn:sequenceFlow id="Flow_G2_KhongTonTai" name="Không tồn tại" sourceRef="Gateway_G2_TonTai" targetRef="Task_CSKH_TuChoiDon" />
    <bpmn:sequenceFlow id="Flow_ToEndTuChoi" sourceRef="Task_CSKH_TuChoiDon" targetRef="End_TuChoiDon" />
    <bpmn:sequenceFlow id="Flow_To_G3" sourceRef="Task_CSKH_PhanLoai" targetRef="Gateway_G3_PhamVi" />
    <bpmn:sequenceFlow id="Flow_CSKH_XuLy" name="CSKH tự xử lý" sourceRef="Gateway_G3_PhamVi" targetRef="Task_CSKH_GiaiQuyetTrucTiep" />
    <bpmn:sequenceFlow id="Flow_ChuyenChuyenMon" name="Chuyển BP liên quan" sourceRef="Gateway_G3_PhamVi" targetRef="Task_BP_XacMinh" />
    <bpmn:sequenceFlow id="Flow_To_G4" sourceRef="Task_BP_XacMinh" targetRef="Gateway_G4_HopLeThucTe" />
    <bpmn:sequenceFlow id="Flow_G4_HopLe" name="Hợp lệ" sourceRef="Gateway_G4_HopLeThucTe" targetRef="Task_BP_DeXuat" />
    <bpmn:sequenceFlow id="Flow_G4_KhongHopLe" name="Không có cơ sở" sourceRef="Gateway_G4_HopLeThucTe" targetRef="Task_BP_TuChoi" />
    <bpmn:sequenceFlow id="Flow_To_G5" sourceRef="Task_BP_DeXuat" targetRef="Gateway_G5_ChinhSach" />
    <bpmn:sequenceFlow id="Flow_BP_DonePA" name="Đúng chính sách" sourceRef="Gateway_G5_ChinhSach" targetRef="Gateway_HoiTu_PhuongAn" />
    <bpmn:sequenceFlow id="Flow_ChinhSach_Sua" name="Chưa đạt" sourceRef="Gateway_G5_ChinhSach" targetRef="Task_BP_XacMinh" />
    <bpmn:sequenceFlow id="Flow_From_TuChoiChuyenMon" sourceRef="Task_BP_TuChoi" targetRef="Gateway_HoiTu_PhuongAn" />
    <bpmn:sequenceFlow id="Flow_CSKH_DonePA" sourceRef="Task_CSKH_GiaiQuyetTrucTiep" targetRef="Gateway_HoiTu_PhuongAn" />
    <bpmn:sequenceFlow id="Flow_To_PhanHoiKH" sourceRef="Gateway_HoiTu_PhuongAn" targetRef="Task_CSKH_GuiPhanHoi" />
    <bpmn:sequenceFlow id="Flow_Loop_DieuChinh" sourceRef="Task_CSKH_ThuongLuong" targetRef="Task_BP_XacMinh" />
    <bpmn:sequenceFlow id="Flow_To_HT_Luu" sourceRef="Task_CSKH_ThucThi" targetRef="Task_HT_LuuKetQua" />
    <bpmn:sequenceFlow id="Flow_ToEndHoanTat" sourceRef="Task_HT_LuuKetQua" targetRef="End_HoanTat" />
    <bpmn:exclusiveGateway id="Gateway_HoiTu_PhuongAn">
      <bpmn:incoming>Flow_CSKH_DonePA</bpmn:incoming>
      <bpmn:incoming>Flow_BP_DonePA</bpmn:incoming>
      <bpmn:incoming>Flow_From_TuChoiChuyenMon</bpmn:incoming>
      <bpmn:outgoing>Flow_To_PhanHoiKH</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_BP_TuChoi" name="Lập biên bản từ chối / Nêu rõ lý do">
      <bpmn:incoming>Flow_G4_KhongHopLe</bpmn:incoming>
      <bpmn:outgoing>Flow_From_TuChoiChuyenMon</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_G4_HopLeThucTe" name="Khiếu nại hợp lệ &#38; đúng thực tế?">
      <bpmn:incoming>Flow_To_G4</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_HopLe</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_KhongHopLe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_KhieuNai">
      <bpmndi:BPMNShape id="Participant_KhachHang_di" bpmnElement="Participant_KhachHang" isHorizontal="true" bioc:stroke="#000000" bioc:fill="#ffffff" color:background-color="#ffffff" color:border-color="#000000">
