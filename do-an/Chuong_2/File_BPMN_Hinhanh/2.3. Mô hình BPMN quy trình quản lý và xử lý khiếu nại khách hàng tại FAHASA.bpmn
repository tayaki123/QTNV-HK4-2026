<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_SP03_UltraClean" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.25.1">
  <bpmn:collaboration id="Collaboration_Wholesale">
    <bpmn:participant id="Participant_WholesaleCus" name="Khách hàng sỉ" processRef="Process_WholesaleCus" />
    <bpmn:participant id="Participant_FAHASA_B2B" name="FAHASA" processRef="Process_FAHASA_B2B" />
    <bpmn:messageFlow id="Flow_Msg_1" name="Gửi danh mục mua sỉ" sourceRef="Task_Cus_SendReq" targetRef="Task_B2B_Receive" />
    <bpmn:messageFlow id="Flow_Msg_2" name="Gửi Báo giá &#38; Chiết khấu" sourceRef="Task_B2B_Quote" targetRef="Task_Cus_CheckQuote" />
    <bpmn:messageFlow id="Flow_Msg_3" name="Giao nhận &#38; Biên bản" sourceRef="Task_Log_Deliver" targetRef="Task_Cus_Inspect" />
  </bpmn:collaboration>
  <bpmn:process id="Process_WholesaleCus" isExecutable="false">
    <bpmn:startEvent id="Start_Wholesale" name="Nhu cầu mua sỉ">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Cus_SendReq" name="Cung cấp nhu cầu &#38; số lượng đặt mua">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_Clarify" name="Bổ sung / Làm rõ danh mục">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_CheckQuote" name="Kiểm tra báo giá &#38; chiết khấu">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_Pay" name="Thanh toán / Cam kết công nợ">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_C5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Cus_Inspect" name="Kiểm đếm &#38; Nghiệm thu hàng hóa">
      <bpmn:incoming>Flow_C5</bpmn:incoming>
      <bpmn:outgoing>Flow_C6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Wholesale_Cus" name="Hoàn tất tiếp nhận">
      <bpmn:incoming>Flow_C6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="Start_Wholesale" targetRef="Task_Cus_SendReq" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_Cus_SendReq" targetRef="Task_Cus_Clarify" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Task_Cus_Clarify" targetRef="Task_Cus_CheckQuote" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Task_Cus_CheckQuote" targetRef="Task_Cus_Pay" />
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Task_Cus_Pay" targetRef="Task_Cus_Inspect" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_Cus_Inspect" targetRef="End_Wholesale_Cus" />
  </bpmn:process>
  <bpmn:process id="Process_FAHASA_B2B" isExecutable="false">
    <bpmn:laneSet id="LaneSet_B2B">
      <bpmn:lane id="Lane_B2B_Dept" name="Bộ phận Kinh doanh (B2B)">
        <bpmn:flowNodeRef>Task_B2B_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B2B_RetailGuide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B2B_Compensate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B2B_ReqClarify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_B2B_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B2B_Quote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B2B_OrderCreate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_B2B_ReQuote</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WH_Dept" name="Bộ phận Kho vận">
        <bpmn:flowNodeRef>Task_WH_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WH_ReportShortage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WH_Prepare</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Acc_Dept" name="Bộ phận Kế toán / Thanh toán">
        <bpmn:flowNodeRef>Task_Acc_Invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Acc_Hold</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Log_OMS" name="Đơn vị Vận chuyển / Hệ thống OMS">
        <bpmn:flowNodeRef>Gateway_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OMS_Close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_B2B_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Log_SelfPickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Log_Deliver</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Task_B2B_Receive" name="Tiếp nhận yêu cầu mua sỉ">
      <bpmn:outgoing>Flow_F1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_1" name="G1: Đủ điều kiện chính sách mua sỉ?">
      <bpmn:incoming>Flow_F1</bpmn:incoming>
      <bpmn:outgoing>Flow_G1_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G1_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_B2B_RetailGuide" name="Hướng dẫn mua theo diện bán lẻ">
      <bpmn:incoming>Flow_G1_No</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Cancel1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_2" name="G2: Danh mục yêu cầu rõ ràng?">
      <bpmn:incoming>Flow_G1_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_G2_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G2_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_B2B_Compensate" name="Xử lý giao bù / Điều chỉnh công nợ">
      <bpmn:incoming>Flow_G8_HasIssue</bpmn:incoming>
      <bpmn:outgoing>Flow_Comp_Done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WH_CheckStock" name="Kiểm tra tồn kho &#38; khả năng cung ứng">
      <bpmn:incoming>Flow_G2_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Clarify_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_3" name="G3: Tồn kho đáp ứng đủ 100%?">
      <bpmn:incoming>Flow_F2</bpmn:incoming>
      <bpmn:outgoing>Flow_G3_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G3_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_WH_ReportShortage" name="Báo thiếu hàng &#38; thời gian gom hàng">
      <bpmn:incoming>Flow_G3_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Shortage_Report</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WH_Prepare" name="Soạn hàng, đóng pallet &#38; in phiếu xuất kho">
      <bpmn:incoming>Flow_G6_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Acc_Invoice" name="Xuất Hóa đơn VAT &#38; Theo dõi thanh toán">
      <bpmn:incoming>Flow_F5</bpmn:incoming>
      <bpmn:incoming>Flow_Pay_Retry</bpmn:incoming>
      <bpmn:outgoing>Flow_F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_6" name="G6: Xác thực thanh toán / Duyệt công nợ?">
      <bpmn:incoming>Flow_F6</bpmn:incoming>
      <bpmn:outgoing>Flow_G6_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G6_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Acc_Hold" name="Tạm dừng đơn chờ xác nhận TT">
      <bpmn:incoming>Flow_G6_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Pay_Retry</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_7" name="G7: Phương thức giao nhận hàng?">
      <bpmn:incoming>Flow_F7</bpmn:incoming>
      <bpmn:outgoing>Flow_G7_Self</bpmn:outgoing>
      <bpmn:outgoing>Flow_G7_Ship</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_8" name="G8: Nghiệm thu có phát sinh sai lệch?">
      <bpmn:incoming>Flow_To_Inspect1</bpmn:incoming>
      <bpmn:incoming>Flow_To_Inspect2</bpmn:incoming>
      <bpmn:outgoing>Flow_G8_Clean</bpmn:outgoing>
      <bpmn:outgoing>Flow_G8_HasIssue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_OMS_Close" name="Cập nhật trạng thái Đơn hàng Hoàn tất">
      <bpmn:incoming>Flow_G8_Clean</bpmn:incoming>
      <bpmn:incoming>Flow_Comp_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_B2B_Success" name="Đơn hàng hoàn tất">
      <bpmn:incoming>Flow_F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_F1" sourceRef="Task_B2B_Receive" targetRef="Gateway_1" />
    <bpmn:sequenceFlow id="Flow_G1_Yes" name="Đạt chuẩn sỉ" sourceRef="Gateway_1" targetRef="Gateway_2" />
    <bpmn:sequenceFlow id="Flow_G1_No" name="Không đạt" sourceRef="Gateway_1" targetRef="Task_B2B_RetailGuide" />
    <bpmn:sequenceFlow id="Flow_To_Cancel1" sourceRef="Task_B2B_RetailGuide" targetRef="End_B2B_Cancel" />
    <bpmn:sequenceFlow id="Flow_G2_Yes" name="Rõ ràng" sourceRef="Gateway_2" targetRef="Task_WH_CheckStock" />
    <bpmn:sequenceFlow id="Flow_G2_No" name="Chưa rõ" sourceRef="Gateway_2" targetRef="Task_B2B_ReqClarify" />
    <bpmn:sequenceFlow id="Flow_Clarify_Done" sourceRef="Task_B2B_ReqClarify" targetRef="Task_WH_CheckStock" />
    <bpmn:sequenceFlow id="Flow_F2" sourceRef="Task_WH_CheckStock" targetRef="Gateway_3" />
    <bpmn:sequenceFlow id="Flow_G3_Yes" name="Đủ hàng 100%" sourceRef="Gateway_3" targetRef="Task_B2B_Quote" />
    <bpmn:sequenceFlow id="Flow_G3_No" name="Thiếu hàng" sourceRef="Gateway_3" targetRef="Task_WH_ReportShortage" />
    <bpmn:sequenceFlow id="Flow_Shortage_Report" sourceRef="Task_WH_ReportShortage" targetRef="Gateway_4" />
    <bpmn:sequenceFlow id="Flow_G4_Yes" name="Đồng ý điều chỉnh" sourceRef="Gateway_4" targetRef="Task_B2B_Quote" />
    <bpmn:sequenceFlow id="Flow_G4_No" name="Hủy" sourceRef="Gateway_4" targetRef="End_B2B_Cancel" />
    <bpmn:sequenceFlow id="Flow_F4" sourceRef="Task_B2B_Quote" targetRef="Gateway_5" />
    <bpmn:sequenceFlow id="Flow_G5_Yes" name="Đồng ý Báo giá" sourceRef="Gateway_5" targetRef="Task_B2B_OrderCreate" />
    <bpmn:sequenceFlow id="Flow_G5_Negotiate" name="Đàm phán lại" sourceRef="Gateway_5" targetRef="Task_B2B_ReQuote" />
    <bpmn:sequenceFlow id="Flow_G5_No" name="Hủy" sourceRef="Gateway_5" targetRef="End_B2B_Cancel" />
    <bpmn:sequenceFlow id="Flow_ReQuote_Done" sourceRef="Task_B2B_ReQuote" targetRef="Task_B2B_Quote" />
    <bpmn:sequenceFlow id="Flow_F5" sourceRef="Task_B2B_OrderCreate" targetRef="Task_Acc_Invoice" />
    <bpmn:sequenceFlow id="Flow_F6" sourceRef="Task_Acc_Invoice" targetRef="Gateway_6" />
    <bpmn:sequenceFlow id="Flow_G6_Yes" name="Đạt chuẩn TT" sourceRef="Gateway_6" targetRef="Task_WH_Prepare" />
    <bpmn:sequenceFlow id="Flow_G6_No" name="Chưa thanh toán" sourceRef="Gateway_6" targetRef="Task_Acc_Hold" />
    <bpmn:sequenceFlow id="Flow_Pay_Retry" sourceRef="Task_Acc_Hold" targetRef="Task_Acc_Invoice" />
    <bpmn:sequenceFlow id="Flow_F7" sourceRef="Task_WH_Prepare" targetRef="Gateway_7" />
    <bpmn:sequenceFlow id="Flow_G7_Self" name="Tự nhận kho" sourceRef="Gateway_7" targetRef="Task_Log_SelfPickup" />
    <bpmn:sequenceFlow id="Flow_G7_Ship" name="Giao tận nơi" sourceRef="Gateway_7" targetRef="Task_Log_Deliver" />
    <bpmn:sequenceFlow id="Flow_To_Inspect1" sourceRef="Task_Log_SelfPickup" targetRef="Gateway_8" />
    <bpmn:sequenceFlow id="Flow_To_Inspect2" sourceRef="Task_Log_Deliver" targetRef="Gateway_8" />
    <bpmn:sequenceFlow id="Flow_G8_Clean" name="Đạt 100%" sourceRef="Gateway_8" targetRef="Task_OMS_Close" />
    <bpmn:sequenceFlow id="Flow_G8_HasIssue" name="Có sai lệch" sourceRef="Gateway_8" targetRef="Task_B2B_Compensate" />
    <bpmn:sequenceFlow id="Flow_Comp_Done" sourceRef="Task_B2B_Compensate" targetRef="Task_OMS_Close" />
    <bpmn:sequenceFlow id="Flow_F8" sourceRef="Task_OMS_Close" targetRef="End_B2B_Success" />
    <bpmn:task id="Task_Log_SelfPickup" name="Khách nhận trực tiếp tại Tổng kho">
      <bpmn:incoming>Flow_G7_Self</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Inspect1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Log_Deliver" name="Vận chuyển &#38; giao hàng tận nơi">
      <bpmn:incoming>Flow_G7_Ship</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Inspect2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_4" name="G4: KH đồng ý điều chỉnh số lượng/thời gian?">
      <bpmn:incoming>Flow_Shortage_Report</bpmn:incoming>
      <bpmn:outgoing>Flow_G4_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G4_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_B2B_ReqClarify" name="Liên hệ KH làm rõ danh mục">
      <bpmn:incoming>Flow_G2_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Clarify_Done</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_B2B_Cancel" name="Hủy / Kết thúc quy trình">
      <bpmn:incoming>Flow_To_Cancel1</bpmn:incoming>
      <bpmn:incoming>Flow_G4_No</bpmn:incoming>
      <bpmn:incoming>Flow_G5_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_B2B_Quote" name="Lập Báo giá &#38; Chính sách chiết khấu sỉ">
      <bpmn:incoming>Flow_G3_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_G4_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_ReQuote_Done</bpmn:incoming>
      <bpmn:outgoing>Flow_F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_5" name="G5: KH đồng ý Báo giá?">
      <bpmn:incoming>Flow_F4</bpmn:incoming>
      <bpmn:outgoing>Flow_G5_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_Negotiate</bpmn:outgoing>
      <bpmn:outgoing>Flow_G5_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_B2B_OrderCreate" name="Tạo đơn hàng sỉ (B2B Order) trên hệ thống">
      <bpmn:incoming>Flow_G5_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_B2B_ReQuote" name="Đàm phán lại mức chiết khấu">
      <bpmn:incoming>Flow_G5_Negotiate</bpmn:incoming>
      <bpmn:outgoing>Flow_ReQuote_Done</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Wholesale">
    <bpmndi:BPMNPlane id="BPMNPlane_Wholesale" bpmnElement="Collaboration_Wholesale">
      <bpmndi:BPMNShape id="Participant_WholesaleCus_di" bpmnElement="Participant_WholesaleCus" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="3750" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Wholesale_di" bpmnElement="Start_Wholesale" bioc:stroke="#198754" bioc:fill="#d1e7dd" color:background-color="#d1e7dd" color:border-color="#198754">
        <dc:Bounds x="210" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="185" width="76" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_SendReq_di" bpmnElement="Task_Cus_SendReq" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="280" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_Clarify_di" bpmnElement="Task_Cus_Clarify" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="740" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_CheckQuote_di" bpmnElement="Task_Cus_CheckQuote" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="1710" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_Pay_di" bpmnElement="Task_Cus_Pay" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="2270" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Cus_Inspect_di" bpmnElement="Task_Cus_Inspect" bioc:stroke="#0d6efd" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d6efd">
        <dc:Bounds x="3190" y="120" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Wholesale_Cus_di" bpmnElement="End_Wholesale_Cus" bioc:stroke="#198754" bioc:fill="#d1e7dd" color:background-color="#d1e7dd" color:border-color="#198754">
        <dc:Bounds x="3380" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3353" y="185" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_C1_di" bpmnElement="Flow_C1">
        <di:waypoint x="246" y="160" />
        <di:waypoint x="280" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C2_di" bpmnElement="Flow_C2">
        <di:waypoint x="390" y="160" />
        <di:waypoint x="740" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C3_di" bpmnElement="Flow_C3">
        <di:waypoint x="850" y="160" />
        <di:waypoint x="1710" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C4_di" bpmnElement="Flow_C4">
        <di:waypoint x="1820" y="160" />
        <di:waypoint x="2270" y="160" />
